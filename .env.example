# PATRA — environment
#
# Copy this file to .env.local and fill in the values from your Supabase
# project. Never commit .env.local. Never hardcode these anywhere in src.
#
#   Supabase Dashboard -> Project Settings -> API
#
# Until these are filled in the application still runs: authentication falls
# back to the mock traveller and every frozen screen renders unchanged.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key. Safe to expose to the browser; row level security
# is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SERVER ONLY. Bypasses row level security.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Absolute origin used to build the links in confirmation and
# password-reset emails. Falls back to the request host in development.
# In production set this to your deployed URL, e.g. https://patra.example.com
NEXT_PUBLIC_SITE_URL=

# Optional. Set to 0 to view the frozen commissioning briefs instead of the
# delivered photography.
# NEXT_PUBLIC_PRESENTATION=1